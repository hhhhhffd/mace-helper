#!/bin/sh

##############################################################################
#
#  Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

app_path=$0

while
    app_path=${app_path#"${app_path%%[!/]*}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
      /*) app_path=$link ;;
      *)  app_path=$( dirname "$app_path" )/$link ;;
    esac
done

app_home=$( cd "${app_path%/*}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

if [ -h "$app_home/$APP_BASE_NAME" ]; then
    ls=$( ls -ld "$app_home/$APP_BASE_NAME" )
    link=${ls#*' -> '}
    case $link in
      /*) app_home=$link ;;
      *)  app_home=$( dirname "$app_home/$APP_BASE_NAME" )/$link ;;
    esac
fi

set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$app_home/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

exec java -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS "$@"
